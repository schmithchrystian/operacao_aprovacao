# Local development. Never copy demonstration settings into a commercial deployment.
APP_ENV=development
DATA_SOURCE=mock
# For PostgreSQL use DATA_SOURCE=prisma and the URLs of an isolated database.
DATABASE_URL=postgresql://study_test:test-only-password@127.0.0.1:5432/study_test
DIRECT_URL=postgresql://study_test:test-only-password@127.0.0.1:5432/study_test
DATABASE_POOL_MAX=5
# Production/staging require independent random secrets of at least 32 characters.
# AUTH_SECRET=
# CRON_SECRET=
# Never enable demo seeding in staging/production.
ALLOW_DEMO_SEED=false
# Public canonical URL and transactional email (optional locally; required for account emails).
APP_URL=http://localhost:3000
# RESEND_API_KEY=
# EMAIL_FROM=Plataforma <contato@seu-dominio.example>
# Queue encryption: generate 32 random bytes in Base64; keep separate from AUTH_SECRET.
# ACCOUNT_EMAIL_ENCRYPTION_KEY=
# Trust an IP header only when your reverse proxy overwrites it for every request.
# TRUSTED_PROXY_IP_HEADER=x-vercel-forwarded-for
# Private PDF bucket; service key is server-only. Never use a public bucket.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lesson-materials
# Optional paid access. Enable only after configuring and validating Stripe webhooks.
BILLING_REQUIRED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# Private MP4 objects are linked as storage:videos/random-key.mp4 in the admin.
SUPABASE_VIDEO_BUCKET=lesson-videos
